# Copy to .env for local development. Never commit real secrets.

DATABASE_URL=postgres://inbox:inbox@localhost:5432/inbox_pilot

# API
PORT=3000
HOST=0.0.0.0
SCHEDULER_BEARER_TOKEN=local-scheduler-token-change-me
OWNER_PASSWORD=local-dev-only-change-me

# 64 hex chars (32 bytes) for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Jev / TypeSafe (required for live classify in Stage 3+)
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-1.13.0

# Gmail OAuth (Stage 2+)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback

# Session
# SESSION_SECRET=replace-with-long-random-string

# Feature flags — owner accepted provider retention terms 2026-10-21
REAL_MAIL_TO_JEV_ENABLED=true
# Use mock Gmail discovery when OAuth is not configured
GMAIL_MODE=mock

