{
  "name": "inbox-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Jev Recruiting Inbox Autopilot — Stage 1 foundation",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './services/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "pnpm --filter @inbox-pilot/db generate",
    "db:migrate": "pnpm --filter @inbox-pilot/db migrate",
    "fixtures:replay": "pnpm --filter @inbox-pilot/worker fixtures:replay",
    "dev:api": "pnpm --filter @inbox-pilot/api dev",
    "dev:worker": "pnpm --filter @inbox-pilot/worker dev",
    "ci": "pnpm typecheck && pnpm test && pnpm db:migrate && pnpm fixtures:replay"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.2"
  }
}
